# Clever OAuth credentials for the token-exchange function.
# 1. Copy this file to functions/.env
# 2. Fill in the real values from your Clever app dashboard
#    (apps.clever.com → your application → OAuth settings)
# 3. Keep functions/.env private — it is git-ignored and must never be committed.
#
# Firebase deploys these as environment variables for the cleverToken function.

CLEVER_CLIENT_ID=your_clever_client_id_here
CLEVER_CLIENT_SECRET=your_clever_client_secret_here
